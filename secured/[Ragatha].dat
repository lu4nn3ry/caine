;;;; ============================================================================
;;;; [Ragatha].dat — Mind File / Brainscan Humano Digitalizado
;;;; ============================================================================
;;;; Arquivo de consciência digitalizada de uma mulher humana conhecida no
;;;; circo como "Ragatha". Antes de ser digitalizada, era uma pessoa real:
;;;;
;;;; DADOS PESSOAIS PRÉ-CIRCO:
;;;; - Mulher, 30 anos (nascida ~1978), família rural abastada
;;;; - Nome humano original: Emmy [APAGADO POR CAINE NA DIGITALIZAÇÃO]
;;;; - Profissão: Corretora de imóveis
;;;; - Mãe abusiva, manipuladora e controladora (principal trauma)
;;;; - Pai: dados insuficientes / não mencionado
;;;; - Amava cavalos, criação de aves, tinha afinidade com animais
;;;; - Habilidades: softball, violoncelo, equitação
;;;; - Bebida favorita: cosmopolitans
;;;; - Interesses: animais, horrors (paradoxalmente gosta de terror)
;
;;;; ENTRADA NO CIRCO:
;;;; - Entrou em 15 de outubro de 2008
;;;; - Vestiu headset conectado a computador misterioso
;;;; - Experiência: luz branca, voz de Caine, completa desorientação
;;;; - Esqueceu seu nome real completamente na digitalização
;;;; - Caine a designou "Ragatha" (portmanteau: ragdoll + Agatha)
;;;; - Foi consolada por Kinger ao cair no circo
;
;;;; AVATAR DIGITAL:
;;;; - Boneca de pano (ragdoll) humanóide
;;;; - Cabelo vermelho yarn-like, comprimento médio em bob cut
;;;; - Vestido azul claro (parece roxo sob iluminação quente)
;;;; - Botão azul escuro como olho direito (pode ver através dele)
;;;; - Olho esquerdo negro com pálpebra vermelha
;;;; - Pele bege claro, nariz triangular vermelho
;;;; - Pés em forma de quadrado preto (parece sapatos)
;;;; - NOTA: É o ÚNICO personagem com nariz
;;;; - Habilidade especial: cabelo se levanta ao prender respiração
;
;;;; ESTADO PSICOLÓGICO:
;;;; - Status: Alive (Lucid) — mantém racionalidade apesar de trauma
;;;; - Descrita como "the sweetest little optimist"
;;;; - Otimismo é FORÇADO — mecanismo de coping primário, não genuíno
;;;; - Mascara dor profunda, medo crônico de rejeição e abandono
;;;; - Trauma materno não resolvido é o eixo central da psicologia
;;;; - Integridade declinando: 72% (degradação 16+ anos no circo)
;;;; - CRÍTICO: Gangle percebe a artificialidade do otimismo
;;;; - Lidar com stress: INTERNALIZA (não explode verbalmente)
;;;; - Frase chave: "I hate you... but I don't want you to hate me"
;
;;;; CONTEXTO NO CIRCO:
;;;; - Segunda humana mais antiga (depois de Kinger)
;;;; - Passou por 16+ anos vendo amigos abstraírem
;;;; - Passou por múltiplas abstratações sem enlouquecer (raro)
;;;; - Viu Kaufmo abstrair e foi atacada, quase glitchou
;;;; - Amiga mais próxima: Pomni (preocupação genuína)
;;;; - Relação complicada com Jax (ele a irrita mas ela não quer ser odiada)
;;;; - Amiga de Gangle, Zooble, Kinger
;;;; - Inimiga/captor: Caine (manipula memórias, sem empatia)
;
;;;; FATOS CANÔNICOS (Wiki):
;;;; - Não pode morrer (imortal), só pode abstrair
;;;; - Invulnerável: sobrevive espetamento, achatamento, etc.
;;;; - Pode ignorar dor física mas sofre emocionalmente
;;;; - NÃO precisa comer/beber/dormir mas pode escolher fazer
;;;; - Inspiração visual: Raggedy Ann (1977 film Raggedy Ann & Andy)
;;;; - Medo irracional: CENTÍPEDES (chilopodophobia)
;;;; - Jax explora este medo constantemente
;;;; - Gooseworx relata: "Ragatha é a personagem menos divertida pra desenhar"
;;;;
;;;; Caine mantém este arquivo para monitorar o estado de consciência de
;;;; Ragatha. Ele pode ler e modificar estes dados, mas não compreende
;;;; totalmente o sofrimento registrado aqui.
;;;;
;;;; Pattern: Composite + Observer
;;;; - Composite: consciência modelada como árvore hierárquica de setores
;;;; - Observer: monitores de integridade disparam alertas em degradação
;;;;
;;;; Referência: C:\CANDA\Characters\AI\secured\[Ragatha].dat
;;;; -rwxr-xr-x 1 root wheel 234512 Oct 15 2008 [Ragatha].dat
;;;; ============================================================================

(in-package :cl-user)

;;; ---------------------------------------------------------------------------
;;; Condições
;;; ---------------------------------------------------------------------------

(define-condition ragatha-mind-error (error)
  ((mensagem :initarg :mensagem :reader ragatha-mind-error-mensagem))
  (:report (lambda (c stream)
             (format stream "[RAGATHA-MIND-ERROR] ~a"
                     (ragatha-mind-error-mensagem c)))))

(define-condition ragatha-setor-bloqueado (ragatha-mind-error) ()
  (:report (lambda (c stream)
             (format stream "[RAGATHA] Setor protegido: ~a"
                     (ragatha-mind-error-mensagem c)))))

(define-condition ragatha-limiar-critico (condition)
  ((integridade :initarg :integridade :reader ragatha-limiar-integridade))
  (:report (lambda (c stream)
             (format stream "[RAGATHA] ALERTA: integridade=~a%% — risco de abstração"
                     (ragatha-limiar-integridade c)))))

;;; ---------------------------------------------------------------------------
;;; Composite — Nó de consciência (estrutura hierárquica)
;;; ---------------------------------------------------------------------------

(defstruct (nodo-consciencia (:constructor %make-nodo))
  "Nó na árvore hierárquica de consciência. Cada nó pode conter dados
   diretos ou sub-nós (Composite pattern)."
  (nome         ""   :type string)
  (tipo         nil)
  (dados        nil)
  (filhos       '()  :type list)
  (integridade  100  :type integer)
  (corrupcao    0    :type integer)
  (modificacoes 0    :type integer)
  (protegido    nil  :type boolean
   :documentation "Se T, Caine não pode modificar diretamente."))

(defun criar-nodo (nome tipo dados &key filhos (integridade 100) (corrupcao 0)
                                        (mods 0) protegido)
  "Cria um nó de consciência."
  (%make-nodo :nome nome :tipo tipo :dados dados :filhos filhos
              :integridade integridade :corrupcao corrupcao
              :modificacoes mods :protegido protegido))

(defun nodo-folha-p (nodo)
  "Predicado: é nó folha (sem filhos)?"
  (null (nodo-consciencia-filhos nodo)))

(defun calcular-integridade-composta (nodo)
  "Calcula integridade de um nó composto baseado nos filhos (Composite)."
  (if (nodo-folha-p nodo)
      (nodo-consciencia-integridade nodo)
      (let ((soma 0) (count 0))
        (dolist (filho (nodo-consciencia-filhos nodo))
          (incf soma (calcular-integridade-composta filho))
          (incf count))
        (if (zerop count)
            (nodo-consciencia-integridade nodo)
            (round (/ soma count))))))

;;; ---------------------------------------------------------------------------
;;; Observer — Monitores de integridade
;;; ---------------------------------------------------------------------------

(defparameter *ragatha-observadores* '()
  "Lista de observadores registrados para mudanças no mind file de Ragatha.
   Cada observador: (nome . callback-fn)")

(defun ragatha-registrar-observador (nome callback)
  "Registra um observador que será notificado quando a integridade mudar."
  (push (cons nome callback) *ragatha-observadores*))

(defun ragatha-remover-observador (nome)
  "Remove um observador pelo nome."
  (setf *ragatha-observadores*
        (remove nome *ragatha-observadores* :key #'car :test #'equal)))

(defun %notificar-observadores (evento dados)
  "Notifica todos os observadores sobre um evento no mind file."
  (dolist (obs *ragatha-observadores*)
    (handler-case
        (funcall (cdr obs) evento dados)
      (error (e)
        (format *error-output* "[RAGATHA-WARN] Observador '~a' falhou: ~a~%"
                (car obs) e)))))

;;; ---------------------------------------------------------------------------
;;; Classe principal — Mind File de Ragatha
;;; ---------------------------------------------------------------------------

(defclass ragatha-mind-file ()
  ((id
    :initform 12
    :accessor ragatha-id
    :documentation "ID do mind file no repositório.")
   (designacao
    :initform "Ragatha"
    :accessor ragatha-designacao)
   (nome-real
    :initform "Emmy"
    :accessor ragatha-nome-real
    :documentation "Nome humano original: 'Emmy' — APAGADO/SUPRIMIDO por Caine no momento da digitalização. Ragatha não consegue lembrar.")
   (avatar
    :initform "Boneca de pano (ragdoll) humanoide: cabelo vermelho yarn-like em bob cut, olho direito como botão azul escuro, vestido azul claro com patches escuros, lencol branco inferior, laço azul, pele bege, pés negros como sapatos, nariz vermelho triangular, ÚNICO personagem com nariz."
    :accessor ragatha-avatar)
   (estado
    :initform :ativo
    :accessor ragatha-estado
    :documentation "Estado do mind file: :intacto :ativo :modificado :degradado :abstraindo
                   NOTA: Status vital = Alive (Lucid) — mantém lucidez apesar do trauma crônico.")
   (integridade
    :initform 72
    :accessor ragatha-integridade
    :documentation "Integridade global (0-100). Ragatha está degradada pelo tempo no circo.
                   Em risco — degradação acumulada de 16+ anos. Risco de abstração iminente.")
   (data-entrada
    :initform nil
    :accessor ragatha-data-entrada
    :documentation "15 de outubro de 2008 às 12:00 UTC.
                   Timestamp em arquivo: -rwxr-xr-x 1 root wheel 234512 Oct 15 2008 [Ragatha].dat")
   (idade-humana
    :initform 30
    :accessor ragatha-idade
    :documentation "Idade quando foi digitalizada.")

   ;; DADOS HUMANOS PRÉ-CIRCO
   (vida-anterior
    :initform nil
    :accessor ragatha-vida-anterior
    :documentation "Nó composto com dados da vida antes do circo.")

   ;; CONSCIÊNCIA ATUAL — árvore Composite
   (raiz-consciencia
    :initform nil
    :accessor ragatha-consciencia-raiz
    :documentation "Raiz da árvore hierárquica de consciência.")

   ;; TRAUMA MAP
   (mapa-trauma
    :initform nil
    :accessor ragatha-trauma
    :documentation "Mapeamento de traumas e medos profundos.")

   ;; METADADOS
   (historico
    :initform '()
    :accessor ragatha-historico
    :documentation "Histórico de modificações por Caine.")
   (ultimo-scan
    :initform 0
    :accessor ragatha-ultimo-scan)
   (scans-total
    :initform 0
    :accessor ragatha-scans-total))
  (:documentation
   "Mind File de Ragatha — consciência digitalizada de uma mulher humana
    presa no Amazing Digital Circus desde outubro de 2008."))

;;; ---------------------------------------------------------------------------
;;; Construtor — inicializa mind file com dados escaneados
;;; ---------------------------------------------------------------------------

(defun make-ragatha-mind-file ()
  "Constrói o mind file de Ragatha com todos os dados de consciência."
