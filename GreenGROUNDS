(defun daemon-autenticar (daemon codigo)
  "Tenta autenticar com código. Caine sempre rejeita."
  (incf (daemon-tentativas-auth daemon))
  (incf (getf (daemon-metricas daemon) :auth-falhas))

  (cond
    ((string= codigo "admin1234")
     (format t "$: INCORRECT! That's not even CLOSE to wacky enough!~%")
     (format t "$: Retry with different code? [Y/M]~%")
     nil)

    ((> (daemon-tentativas-auth daemon) (daemon-max-tentativas-auth daemon))
     (format t "$: Too many attempts! I must hand it to y•u ¢ an , ")
     (format t "y•ur mind was a¢€ways resource&uL~%")
     (format t "WACKYTIME_LOCKOUT: Accelerating...~%")
     nil)

    (t
     (format t "$: INCORRECT! Enter WACKY code_~%")
     (format t "$: Aborting fallback requires ADMINISTRATOR confirmation!~%")
