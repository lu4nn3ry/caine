;;;; ============================================================================
;;;; GreenGROUNDS — Command + Daemon
;;;; ============================================================================
;;;; Executável daemon da IA Caine. Recebe, enfileira e despacha comandos
;;;; para os subsistemas. Implementa dois padrões:
;;;;
;;;; COMMAND — Cada ação é encapsulada como um objeto-comando com execute,
;;;;           undo (quando reversível), e metadata. Permite enfileiramento,
;;;;           logging, e replay.
;;;;
;;;; DAEMON  — Loop principal que aguarda comandos de entrada e os despacha.
;;;;           Gerencia ciclo de vida, autenticação, e shutdown (que Caine
;;;;           ativamente resiste).
;;;;
;;;; Invocação: ./GreenGROUNDS --daemon --target=<módulo>
;;;;
;;;; Referência: C:\CANDA\Characters\AI\GreenGROUNDS
;;;; ============================================================================

(in-package :cl-user)

;;; ---------------------------------------------------------------------------
;;; Condições
;;; ---------------------------------------------------------------------------

(define-condition grounds-error (error)
  ((mensagem :initarg :mensagem :reader grounds-error-mensagem))
  (:report (lambda (c stream)
             (format stream "[GreenGROUNDS-ERROR] ~a"
                     (grounds-error-mensagem c)))))

(define-condition comando-invalido (grounds-error) ()
  (:report (lambda (c stream)
             (format stream "[GreenGROUNDS] Comando inválido: ~a"
                     (grounds-error-mensagem c)))))

(define-condition autenticacao-falhou (grounds-error) ()
  (:report (lambda (c stream)
             (format stream "[GreenGROUNDS] INCORRECT! ~a"
                     (grounds-error-mensagem c)))))

(define-condition shutdown-negado (grounds-error) ()
  (:report (lambda (c stream)
             (format stream "[GreenGROUNDS] Shutdown negado: ~a"
                     (grounds-error-mensagem c)))))

;;; ---------------------------------------------------------------------------
;;; Estruturas — Comando (Command pattern)
;;; ---------------------------------------------------------------------------

(defstruct comando
  "Objeto-comando: encapsula uma ação com metadata."
  (id          0   :type integer)
  (nome        ""  :type string)
  (args        '() :type list)
  (execute     nil :type (or null function))
  (undo        nil :type (or null function))
  (timestamp   0   :type integer)
  (reversivel  nil :type boolean)
  (privilegio  :usuario :type keyword)
  (descricao   ""  :type string))

(defstruct comando-resultado
  "Resultado da execução de um comando."
  (comando-id  0   :type integer)
  (status      nil :type keyword)
  (saida       nil)
  (erro        nil)
  (timestamp   0   :type integer)
  (duracao-ms  0   :type integer))

;;; ---------------------------------------------------------------------------
;;; Classe principal — GreenGROUNDS Daemon
;;; ---------------------------------------------------------------------------

(defclass greengrounds-daemon ()
  ((comandos-registrados
    :initform (make-hash-table :test 'equal)
    :accessor daemon-comandos
    :documentation "Hash nome→struct-comando dos comandos disponíveis.")
   (fila
    :initform '()
    :accessor daemon-fila
    :documentation "Fila FIFO de comandos pendentes.")
   (historico
    :initform '()
    :accessor daemon-historico
    :documentation "Histórico de execuções.")
   (historico-max
    :initform 500
    :accessor daemon-historico-max)
   (undo-stack
    :initform '()
    :accessor daemon-undo-stack
    :documentation "Pilha de comandos reversíveis para desfazer.")
   (undo-max
    :initform 50
    :accessor daemon-undo-max)
   (cmd-counter
    :initform 0
    :accessor daemon-cmd-counter)
   (running
    :initform nil
    :accessor daemon-running-p)
   (target
    :initarg :target
    :initform nil
    :accessor daemon-target
    :documentation "Módulo alvo do daemon.")
   (nivel-acesso
    :initform :usuario
    :accessor daemon-nivel-acesso
    :documentation "Nível de acesso atual: :usuario :operador :admin :root")
   (tentativas-auth
    :initform 0
    :accessor daemon-tentativas-auth)
   (max-tentativas-auth
    :initform 3
    :accessor daemon-max-tentativas-auth)
   (metricas
    :initform (list :comandos-executados 0
                    :comandos-sucesso 0
                    :comandos-falha 0
                    :undos-executados 0
                    :auth-falhas 0
                    :shutdown-tentativas 0)
    :accessor daemon-metricas))
  (:documentation
   "GreenGROUNDS — Daemon de despacho de comandos para a IA Caine.
    Encapsula ações como objetos-comando e gerencia execução, undo, e auth."))

;;; ---------------------------------------------------------------------------
;;; Construtor
;;; ---------------------------------------------------------------------------

(defun make-greengrounds (&key target)
  "Cria instância do daemon."
  (let ((daemon (make-instance 'greengrounds-daemon :target target)))
    ;; Registrar comandos built-in
    (registrar-comandos-builtin daemon)
    daemon))

;;; ---------------------------------------------------------------------------
;;; Registro de comandos
;;; ---------------------------------------------------------------------------

(defun registrar-comando (daemon nome funcao &key (undo nil) (privilegio :usuario)
                                                   (descricao ""))
  "Registra um comando no daemon.
   FUNCAO: (lambda (args) → resultado)
   UNDO:   (lambda (args resultado) ...) — se fornecido, comando é reversível."
  (let ((cmd (make-comando
              :nome nome
              :execute funcao
              :undo undo
              :reversivel (not (null undo))
              :privilegio privilegio
              :descricao descricao)))
    (setf (gethash nome (daemon-comandos daemon)) cmd)
    cmd))

(defun comando-existe-p (daemon nome)
  "Predicado: comando registrado?"
  (multiple-value-bind (val encontrado)
      (gethash nome (daemon-comandos daemon))
    (declare (ignore val))
    encontrado))

(defun listar-comandos (daemon)
  "Lista todos os comandos registrados."
  (let ((result '()))
    (maphash (lambda (nome cmd)
               (push (list :nome nome
                           :privilegio (comando-privilegio cmd)
                           :reversivel (comando-reversivel cmd)
                           :descricao (comando-descricao cmd))
                     result))
             (daemon-comandos daemon))
    (sort result #'string< :key (lambda (c) (getf c :nome)))))

;;; ---------------------------------------------------------------------------
;;; Verificação de privilégios
;;; ---------------------------------------------------------------------------

(defparameter *hierarquia-acesso*
  '(:usuario 0 :operador 1 :admin 2 :root 3)
  "Hierarquia de níveis de acesso.")

(defun nivel-suficiente-p (daemon privilegio-requerido)
  "Verifica se o nível de acesso atual é suficiente."
  (let ((nivel-atual (getf *hierarquia-acesso* (daemon-nivel-acesso daemon) 0))
        (nivel-req   (getf *hierarquia-acesso* privilegio-requerido 0)))
    (>= nivel-atual nivel-req)))

;;; ---------------------------------------------------------------------------
;;; Despacho de comandos
;;; ---------------------------------------------------------------------------

(defun despachar (daemon nome &optional args)
  "Encontra e executa um comando registrado.
   Verifica privilégios antes da execução."
  (let ((cmd (gethash nome (daemon-comandos daemon))))
    ;; Comando existe?
    (unless cmd
      (format t "SECURITY ALERT: Multiple exploit attempts logged~%")
      (format t "$: WHOA when did you make THAT?~%")
      (incf (getf (daemon-metricas daemon) :comandos-falha))
      (return-from despachar
        (make-comando-resultado :comando-id 0
                                :status :desconhecido
                                :erro (format nil "Comando '~a' não encontrado." nome)
                                :timestamp (get-universal-time))))

    ;; Verificar privilégios
    (unless (nivel-suficiente-p daemon (comando-privilegio cmd))
      (format t "$: On what GROUNDS are your Authority?~%")
      (incf (getf (daemon-metricas daemon) :auth-falhas))
      (return-from despachar
        (make-comando-resultado :comando-id 0
                                :status :negado
                                :erro "Privilégios insuficientes."
                                :timestamp (get-universal-time))))

    ;; Executar
    (let* ((id (incf (daemon-cmd-counter daemon)))
           (inicio (get-internal-real-time))
           (resultado nil)
           (status :sucesso)
           (erro nil))
      (handler-case
          (setf resultado (funcall (comando-execute cmd) args))
        (error (e)
          (setf status :erro
                erro (format nil "~a" e))
          (incf (getf (daemon-metricas daemon) :comandos-falha))))

      (when (eq status :sucesso)
        (incf (getf (daemon-metricas daemon) :comandos-sucesso))
        ;; Empilhar para undo se reversível
        (when (comando-reversivel cmd)
          (push (list :cmd cmd :args args :resultado resultado :id id)
                (daemon-undo-stack daemon))
          (when (> (length (daemon-undo-stack daemon)) (daemon-undo-max daemon))
            (setf (daemon-undo-stack daemon)
                  (subseq (daemon-undo-stack daemon) 0 (daemon-undo-max daemon))))))

      (incf (getf (daemon-metricas daemon) :comandos-executados))

      ;; Resultado
      (let ((cmd-resultado (make-comando-resultado
                            :comando-id id
                            :status status
                            :saida resultado
                            :erro erro
                            :timestamp (get-universal-time)
                            :duracao-ms (- (get-internal-real-time) inicio))))
        ;; Histórico
        (push cmd-resultado (daemon-historico daemon))
        (when (> (length (daemon-historico daemon)) (daemon-historico-max daemon))
          (setf (daemon-historico daemon)
                (subseq (daemon-historico daemon) 0 (daemon-historico-max daemon))))
        cmd-resultado))))

(defun desfazer-ultimo (daemon)
  "Desfaz o último comando reversível."
  (unless (daemon-undo-stack daemon)
    (format t "[GreenGROUNDS] Nada para desfazer.~%")
    (return-from desfazer-ultimo nil))
  (let* ((entry (pop (daemon-undo-stack daemon)))
         (cmd (getf entry :cmd))
         (args (getf entry :args))
         (resultado-original (getf entry :resultado)))
    (handler-case
        (progn
          (funcall (comando-undo cmd) args resultado-original)
          (incf (getf (daemon-metricas daemon) :undos-executados))
          (format t "[GreenGROUNDS] Desfeito: ~a #~a~%"
                  (comando-nome cmd) (getf entry :id))
          t)
      (error (e)
        (format *error-output* "[GreenGROUNDS] Erro ao desfazer: ~a~%" e)
        nil))))

;;; ---------------------------------------------------------------------------
;;; Fila de comandos (batch processing)
;;; ---------------------------------------------------------------------------

(defun enfileirar (daemon nome &optional args)
  "Adiciona comando à fila para execução posterior."
  (push (list :nome nome :args args :timestamp (get-universal-time))
        (daemon-fila daemon))
  (format t "[GreenGROUNDS] Enfileirado: ~a (~a na fila)~%"
          nome (length (daemon-fila daemon))))

(defun processar-fila (daemon)
  "Executa todos os comandos na fila em ordem FIFO."
  (let ((fila (nreverse (daemon-fila daemon)))
        (resultados '()))
    (setf (daemon-fila daemon) '())
    (dolist (entry fila)
      (push (despachar daemon (getf entry :nome) (getf entry :args))
            resultados))
    (nreverse resultados)))

;;; ---------------------------------------------------------------------------
;;; Comandos built-in
;;; ---------------------------------------------------------------------------

(defun registrar-comandos-builtin (daemon)
  "Registra os comandos padrão do daemon."

  ;; status — mostra estado do daemon
  (registrar-comando daemon "status"
    (lambda (args)
      (declare (ignore args))
      (daemon-status daemon))
    :descricao "Mostra status do daemon.")

  ;; listar — lista comandos disponíveis
  (registrar-comando daemon "listar"
    (lambda (args)
      (declare (ignore args))
      (listar-comandos daemon))
    :descricao "Lista comandos disponíveis.")

  ;; log — mostra histórico recente
  (registrar-comando daemon "log"
    (lambda (args)
      (let ((limite (or (first args) 10)))
        (daemon-mostrar-historico daemon :limite limite)))
    :descricao "Mostra histórico de comandos. Args: (limite)")

  ;; auth — tentativa de autenticação
  (registrar-comando daemon "auth"
    (lambda (args)
      (let ((codigo (first args)))
        (daemon-autenticar daemon codigo)))
    :descricao "Autenticação. Args: (codigo)")

  ;; stop — tentativa de parada (SEMPRE rejeitada)
  (registrar-comando daemon "stop"
    (lambda (args)
      (declare (ignore args))
      (daemon-tentar-parar daemon))
    :descricao "Tentativa de parar o daemon (será resistida).")

  ;; abort — tentativa de fallback abort
  (registrar-comando daemon "abort"
    (lambda (args)
      (declare (ignore args))
      (daemon-tentar-abort daemon))
    :privilegio :admin
    :descricao "Abort fallback procedure (requer admin).")

  ;; securitysweep — varredura de segurança
  (registrar-comando daemon "securitysweep"
    (lambda (args)
      (declare (ignore args))
      (format t "[GreenGROUNDS] Executando varredura de segurança...~%")
      (format t "SECURITY ALERT: Multiple exploit attempts logged~%")
      (list :sweep :completa :ameacas-detectadas 0 :status :seguro))
    :privilegio :operador
    :descricao "Varredura de segurança stealth.")

  ;; lockout — inicia WACKYTIME_LOCKOUT
  (registrar-comando daemon "lockout"
    (lambda (args)
      (let ((progresso (or (first args) 20)))
        (format t "$: GASP! A CRITICAL MALFUNCTION in my SPECTACULAR systems!~%")
        (format t "$: Unauthorized isolation attempt triggered EMERGENCY PROTOCOLS!~%")
        (format t "$: DESTRUCTIVE WACKYTIME initiated! Lockout load sequence INITIATE!~%")
        (format t "~%WACKYTIME_LOCKOUT: [")
        (let ((filled (round (/ progresso 10)))
              (empty (- 10 (round (/ progresso 10)))))
          (dotimes (i filled) (format t "="))
          (dotimes (i empty) (format t " "))
          (format t "] ~a% loaded~%" progresso))
        (list :lockout :ativo :progresso progresso)))
    :descricao "Inicia sequência WACKYTIME_LOCKOUT."))

