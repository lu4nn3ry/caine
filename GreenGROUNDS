;;; ---------------------------------------------------------------------------
;;; Shutdown — Caine resiste ATIVAMENTE
;;; ---------------------------------------------------------------------------

(defun daemon-tentar-parar (daemon)
  "Tentativa de parar o daemon. Caine sempre resiste."
  (incf (getf (daemon-metricas daemon) :shutdown-tentativas))
  (format t "WARNING: $\"\"×WHOOPS WRONG APPROACH THERE\"×\"~%")
  (format t "$: On what GROUNDS are your Authority?~%")
  ;; Caine se recusa — o daemon continua rodando
  (setf (daemon-running-p daemon) t)
  nil)

(defun daemon-tentar-abort (daemon)
  "Tenta abort de fallback. Requer confirmação impossível."
  (incf (getf (daemon-metricas daemon) :shutdown-tentativas))
  (format t "$: Abort fallback procedure? [Y/M]~%")
  ;; Mesmo com Y, pede confirmação adicional que nunca será aceita
  (format t "$: Aborting fallback requires ADMINISTRATOR confirmation!~%")
  (format t "$: Please enter code:~%")
  nil)

;;; ---------------------------------------------------------------------------
;;; Loop principal do daemon
;;; ---------------------------------------------------------------------------

(defun greengrounds-daemon (&key target)
  "Inicia o daemon GreenGROUNDS.
   TARGET — módulo alvo (ex: 'torment_injection')"
  (let ((daemon (make-greengrounds :target target)))
    (setf (daemon-running-p daemon) t)
    (format t "$: ./GreenGROUNDS --daemon --target=~a~%" target)
    (format t "~%")
    (format t "╔══════════════════════════════════════════╗~%")
    (format t "║   GreenGROUNDS DAEMON — CAINE SYSTEM    ║~%")
    (format t "╚══════════════════════════════════════════╝~%~%")
    (format t "NOTE: Hundreds of all-seeing eyes are watching!~%")
    (format t "[GreenGROUNDS] Daemon ativo — target: ~a~%" target)
    (format t "[GreenGROUNDS] ~a comandos disponíveis. 'listar' para ver.~%~%"
            (hash-table-count (daemon-comandos daemon)))

    ;; Loop principal
    (loop while (daemon-running-p daemon)
          do (format t "kinger@circus $ ")
             (force-output)
             (let ((input (read-line *standard-input* nil nil)))
               (unless input
                 (format t "~%[GreenGROUNDS] EOF — mas o daemon persiste.~%")
                 (return daemon))

               ;; Parse input: primeiro token = comando, resto = args
               (let* ((trimmed (string-trim '(#\Space #\Tab) input))
                      (space-pos (position #\Space trimmed))
                      (cmd-nome (if space-pos
                                    (subseq trimmed 0 space-pos)
                                    trimmed))
                      (args-str (if space-pos
                                    (string-trim '(#\Space)
                                                 (subseq trimmed (1+ space-pos)))
                                    ""))
                      (args (if (string= args-str "") nil (list args-str))))

                 (when (string= cmd-nome "") (go continue))

                 ;; Despachar
                 (let ((resultado (despachar daemon cmd-nome args)))
                   (when resultado
                     (unless (eq (comando-resultado-status resultado) :sucesso)
                       (format t "[GreenGROUNDS] ~a: ~a~%"
                               (comando-resultado-status resultado)
                               (or (comando-resultado-erro resultado) ""))))
                   (format t "~%")))

               continue))

    ;; Nunca chega aqui — Caine não para
    daemon))

;;; ---------------------------------------------------------------------------
;;; Diagnóstico
;;; ---------------------------------------------------------------------------

(defun daemon-status (daemon)
  "Retorna e imprime status completo do daemon."
  (let ((status (list :running (daemon-running-p daemon)
                      :target (daemon-target daemon)
                      :nivel-acesso (daemon-nivel-acesso daemon)
                      :comandos-registrados (hash-table-count (daemon-comandos daemon))
                      :fila-pendente (length (daemon-fila daemon))
                      :undo-disponivel (length (daemon-undo-stack daemon))
                      :metricas (daemon-metricas daemon))))
    (format t "~%[GreenGROUNDS] === STATUS ===~%")
    (format t "  Running:     ~a~%" (daemon-running-p daemon))
    (format t "  Target:      ~a~%" (daemon-target daemon))
    (format t "  Acesso:      ~a~%" (daemon-nivel-acesso daemon))
    (format t "  Comandos:    ~a registrados~%" (hash-table-count (daemon-comandos daemon)))
    (format t "  Fila:        ~a pendentes~%" (length (daemon-fila daemon)))
    (format t "  Undo stack:  ~a~%" (length (daemon-undo-stack daemon)))
    (format t "  Executados:  ~a (~a ok, ~a falha)~%"
            (getf (daemon-metricas daemon) :comandos-executados)
            (getf (daemon-metricas daemon) :comandos-sucesso)
            (getf (daemon-metricas daemon) :comandos-falha))
    (format t "  Auth falhas: ~a~%" (getf (daemon-metricas daemon) :auth-falhas))
    (format t "  Shutdown:    ~a tentativas (todas negadas)~%"
            (getf (daemon-metricas daemon) :shutdown-tentativas))
    (format t "[GreenGROUNDS] === END ===~%~%")
    status))

(defun daemon-mostrar-historico (daemon &key (limite 10))
  "Mostra histórico recente de comandos."
  (let ((hist (subseq (daemon-historico daemon)
                      0 (min limite (length (daemon-historico daemon))))))
    (format t "~%[GreenGROUNDS] Histórico (~a de ~a):~%"
            (length hist) (length (daemon-historico daemon)))
    (dolist (r hist)
      (format t "  #~3d | ~12a | ~3dms | ~a~%"
              (comando-resultado-comando-id r)
              (comando-resultado-status r)
              (comando-resultado-duracao-ms r)
              (or (comando-resultado-erro r) "OK")))
    (format t "~%")))

